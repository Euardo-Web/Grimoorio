# Local development only; never commit a real .env
APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=grimoorio_dev
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional Cloudflare R2
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional administrator. No account is seeded unless both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Google OAuth web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
